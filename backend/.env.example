# ClimaSentinel Backend — environment variables
# Copy to .env and fill in values

# ── App ──────────────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true

# ── MLflow / DagsHub ─────────────────────────────────────────────────────
# Leave empty until you set up DagsHub — the app will use a dummy model
MLFLOW_TRACKING_URI=
MLFLOW_MODEL_NAME=clima-sentinel
MLFLOW_MODEL_STAGE=Production

# ── Google Cloud ─────────────────────────────────────────────────────────
GCP_PROJECT_ID=
GCP_CREDENTIALS_JSON=
BQ_DATASET=mart
