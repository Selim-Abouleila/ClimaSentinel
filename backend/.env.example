# ClimaSentinel Backend — environment variables
# Copy to .env and fill in values

# ── App ───────────────────────────────────────────────────
ENVIRONMENT=development

# ── MLflow model serving ────────────────────────────────
# Optional exact registered-model version.
# Overrides MLFLOW_MODEL_ALIAS when set.
MLFLOW_MODEL_VERSION=

# Registry alias used when no exact version is pinned.
MLFLOW_MODEL_ALIAS=champion

# ── GCP & BigQuery ────────────────────────────────────────
GCP_PROJECT_ID=clima-sentinel
# For local dev, you can use ADC (gcloud auth application-default login)
# For production/CI, paste the minified JSON key here:
# GCP_CREDENTIALS_JSON={"type": "service_account", ...}
BQ_DATASET=dbt_marts
